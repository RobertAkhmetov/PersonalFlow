# Copy to local-private/production.env and replace every placeholder.
GHCR_NAMESPACE=replace-with-lowercase-github-owner
IMAGE_TAG=replace-with-sha-40-hex-from-ghcr
APP_DOMAIN=api.example.net
IDENTITY_DOMAIN=auth.example.net
ACME_EMAIL=alerts@example.net
OWNER_ID=replace-with-generated-guid
OWNER_NAME=personalflow-owner
# Private API/ingress subnet; preflight rejects overlap with other Docker networks.
PRIVATE_SUBNET=172.30.19.0/24
# Fixed Caddy address on that private network, trusted only by the APIs.
PROXY_ADDRESS=172.30.19.10
BACKUP_REMOTE=replace-with-rclone-remote:personalflow
BACKUP_DIRECTORY=/var/backups/personalflow
PG_MAX_CONNECTIONS=60
PG_SHARED_BUFFERS=128MB
POSTGRES_MEMORY_LIMIT=512m
IDENTITY_MEMORY_LIMIT=320m
LIFE_MEMORY_LIMIT=192m
LEARNING_MEMORY_LIMIT=224m
MIGRATION_MEMORY_LIMIT=320m
CADDY_MEMORY_LIMIT=96m
# RESTORE_HOST=personalflow-vps
