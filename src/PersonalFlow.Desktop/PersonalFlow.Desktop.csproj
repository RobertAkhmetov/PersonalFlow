<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net11.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="Avalonia.Desktop" Version="12.1.6" />
        <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.6" />
        <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.23.0" />
        <PackageReference Include="Microsoft.IdentityModel.Protocols.OpenIdConnect" Version="8.23.0" />
        <ProjectReference Include="../PersonalFlow.Client/PersonalFlow.Client.csproj" />
    </ItemGroup>
    <!-- Local-only profile data is copied for developer Debug runs, never into Release. -->
    <ItemGroup Condition="'$(Configuration)' == 'Debug' and Exists('$(MSBuildProjectDirectory)/../../local-private/personal-seed.json')">
        <None Include="$(MSBuildProjectDirectory)/../../local-private/personal-seed.json" Link="personalflow-private-seed.json" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>
</Project>
