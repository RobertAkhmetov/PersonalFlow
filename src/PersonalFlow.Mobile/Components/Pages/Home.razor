        availableLessons = Store.GetCachedLessons()
            .Select(cached => Store.GetCachedLessonContent(cached.Id, cached.Version))
            .Where(lesson => lesson is not null)
            .Select(lesson => lesson!)
            .OrderBy(lesson => lesson.Date < LocalStore.Today ? 1 : 0)
            .ThenBy(lesson => Math.Abs(lesson.Date.DayNumber - LocalStore.Today.DayNumber))
            .ThenBy(lesson => lesson.Version)
            .ToList();
        var selected = selectedId is { } id && selectedVersion is { } version
            ? availableLessons.FirstOrDefault(lesson => lesson.Id == id && lesson.Version == version)
            : null;
        LoadLesson(selected ?? availableLessons.FirstOrDefault());
