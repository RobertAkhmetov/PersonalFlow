    string FormatTargets(ExerciseTemplate exercise)
    {
        if (exercise.Sets.Count == 0) return "Цели не заданы";
        var first = exercise.Sets[0];
        var repeated = exercise.Sets.All(x => x.Repetitions == first.Repetitions && x.Load == first.Load && x.Unit == first.Unit && x.Note == first.Note);
        return repeated ? $"{exercise.Sets.Count} × {WorkoutDocuments.FormatTarget(first)}"
            : string.Join(" / ", exercise.Sets.Select(WorkoutDocuments.FormatTarget));
    }

    string FormatWorkoutLog(TrainingLog log)
    {
        var template = WorkoutDocuments.ReadPlan(log.DayId, log.Name, log.Snapshot);
        var recorded = WorkoutDocuments.ReadLog(log.Results);
        var lines = new List<string>();
        foreach (var exercise in template.Exercises)
        {
            if (!string.IsNullOrWhiteSpace(exercise.Note)) lines.Add($"{exercise.Name} · {exercise.Note}");
            for (var i = 0; i < exercise.Sets.Count; i++)
            {
                var target = exercise.Sets[i]; var result = recorded.Sets.FirstOrDefault(x => x.SetId == target.Id);
                lines.Add($"{exercise.Name} · {i + 1}: {WorkoutDocuments.FormatSetResult(target, result)}");
            }
        }
        if (!string.IsNullOrWhiteSpace(recorded.Notes)) lines.Add(recorded.Notes);
        return string.Join("\n", lines);
    }

    void UpdateSessionSet(TrainingLog log, SetTarget target, ChangeEventArgs e, bool repetitions)
    {
        var value = e.Value?.ToString() ?? string.Empty;
        int? reps = null; decimal? load = null;
        if (repetitions && !string.IsNullOrWhiteSpace(value))
        {
            if (!int.TryParse(value, NumberStyles.None, CultureInfo.InvariantCulture, out var parsed) || parsed is < 0 or > 1000)
            { ShowMessage("Повторы должны быть целым числом от 0 до 1000"); return; }
            reps = parsed;
        }
        else if (!repetitions && !string.IsNullOrWhiteSpace(value))
        {
            if (!decimal.TryParse(value.Replace(',', '.'), NumberStyles.AllowDecimalPoint, CultureInfo.InvariantCulture, out var parsed) || parsed is < 0 or > 100_000)
            { ShowMessage("Проверьте введённую нагрузку"); return; }
            load = parsed;
        }

        var current = logs.FirstOrDefault(x => x.Id == log.Id) ?? log;
        var document = WorkoutDocuments.ReadLog(current.Results);
        var previous = document.Sets.FirstOrDefault(x => x.SetId == target.Id);
        var updated = repetitions
            ? new SetResult(target.Id, reps, previous?.Load, previous?.Completed ?? false)
            : new SetResult(target.Id, previous?.Repetitions, load, previous?.Completed ?? false);
        SaveSessionResults(current, document with { Sets = UpsertSet(document.Sets, updated) });
    }

    void UpdateSessionCompleted(TrainingLog log, SetTarget target, ChangeEventArgs e)
    {
        var current = logs.FirstOrDefault(x => x.Id == log.Id) ?? log;
        var document = WorkoutDocuments.ReadLog(current.Results);
        var previous = document.Sets.FirstOrDefault(x => x.SetId == target.Id);
        var updated = new SetResult(target.Id, previous?.Repetitions, previous?.Load, e.Value is bool value && value);
        SaveSessionResults(current, document with { Sets = UpsertSet(document.Sets, updated) });
    }

    void UpdateSessionNotes(TrainingLog log, ChangeEventArgs e)
    {
        var current = logs.FirstOrDefault(x => x.Id == log.Id) ?? log;
        var document = WorkoutDocuments.ReadLog(current.Results);
        SaveSessionResults(current, document with { Notes = e.Value?.ToString() ?? string.Empty });
    }

    static IReadOnlyList<SetResult> UpsertSet(IReadOnlyList<SetResult> sets, SetResult updated)
    {
        var result = sets.Where(x => x.SetId != updated.SetId).ToList();
        result.Add(updated);
        return result;
    }

    void SaveSessionResults(TrainingLog current, WorkoutLogDocument document)
    {
        Store.Save(current.Id, current with { Results = WorkoutDocuments.WriteLog(document) });
        Refresh();
    }

    void Finish(TrainingLog log)
    {
        var current = Store.All<TrainingLog>().FirstOrDefault(x => x.Id == log.Id);
        if (current is null) return;
        var completed = current with { Finished = true };
        var linkedPlan = current.ScheduleItemId is { } itemId
            ? Store.All<PlanItem>().FirstOrDefault(item => item.Id == itemId)
            : null;
        if (linkedPlan is { Done: false }) linkedPlan = linkedPlan with { Done = true };
        else linkedPlan = null;

        OccurrenceOverride? linkedOccurrence = null;
        if (current.ScheduleSeriesId is { } seriesId && current.ScheduleOriginalDate is { } originalDate &&
            Store.All<Recurrence>().Any(series => series.Id == seriesId))
        {
            var overrideId = RecurrenceProjection.OccurrenceKey(seriesId, originalDate);
            var previous = Store.All<OccurrenceOverride>().FirstOrDefault(item => item.Id == overrideId);
            if (previous?.Done != true)
                linkedOccurrence = new OccurrenceOverride(overrideId, seriesId, originalDate,
                    previous?.MovedTo, true, previous?.Skipped ?? false);
        }
        Store.CompleteWorkout(completed, linkedPlan, linkedOccurrence);
        Refresh(); ShowMessage("Тренировка сохранена в истории");
    }

    void EditResults(TrainingLog log)
    {
        CloseSheets(); resultLogId = log.Id; resultEditor = true;
    }

    void SaveResults()
    {
        if (resultLogId is not { } id) { CloseSheets(); return; }
        CloseSheets(); ShowMessage("Результаты обновлены");
    }

    string FormatTaskTime(string value) => TimeOnly.TryParse(value, CultureInfo.InvariantCulture, DateTimeStyles.None, out var parsed)
        ? parsed.ToString("HH:mm", CultureInfo.InvariantCulture)
        : value;

    string FormatMoscow(DateTimeOffset value) => TimeZoneInfo.ConvertTime(value, Moscow).ToString("d MMM · HH:mm", culture);

    void CloseConfirmation()
    {
        confirmDeleteTask = false; confirmDeleteNote = false; confirmDeleteTrainingDay = false;
        confirmDeleteRecurrence = false; confirmDeleteVacation = false; pendingDeleteNoteId = null; pendingVacationId = null;
    }

    void ConfirmDelete()
    {
        if (confirmDeleteTask) DeleteTask();
        else if (confirmDeleteNote && pendingDeleteNoteId is { } note) { Store.Delete<NoteItem>(note); CloseConfirmation(); Refresh(); ShowMessage("Заметка удалена"); }
        else if (confirmDeleteTrainingDay) DeleteTrainingDay();
        else if (confirmDeleteRecurrence) DeleteRecurrence();
        else if (confirmDeleteVacation) DeleteVacation();
        else CloseConfirmation();
    }

    public void Dispose()
    {
        Reminders.StatusChanged -= OnReminderStatusChanged;
        BackgroundSync.StatusChanged -= OnBackgroundSyncStatusChanged;
        messageTimer?.Dispose();
        answerSaveCancellation?.Cancel();
        answerSaveCancellation?.Dispose();
    }

