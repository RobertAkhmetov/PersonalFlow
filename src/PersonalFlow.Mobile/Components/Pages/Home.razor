@page "/"
@using System.Globalization
@using System.Text.Json.Nodes
@using PersonalFlow.Client
@using PersonalFlow.Core
@using PersonalFlow.Mobile.Reminders
@implements IDisposable
@inject LocalStore Store
@inject ReminderCoordinator Reminders
@inject PrivateSeedImporter PrivateSeed
@inject MobileIdentitySession Identity
@inject MobileSyncCoordinator Synchronizer
@inject MobileBackgroundSync BackgroundSync

<div class="app-shell">
    <header class="app-header">
        <a class="brand" href="" aria-label="PersonalFlow — главная">
            <span class="brand-mark" aria-hidden="true">
                <svg viewBox="0 0 48 48" fill="none">
                    <path d="M7 14c7-7 13-7 20 0s13 7 20 0M7 24c7-7 13-7 20 0s13 7 20 0M7 34c7-7 13-7 20 0s13 7 20 0" />
                    <circle cx="41" cy="9" r="3" />
                </svg>
            </span>
            <span class="brand-name">personal<span>flow</span></span>
        </a>
        <div class="header-actions">
            <span class="local-status"><span class="status-dot"></span>@(authSignedIn ? "Аккаунт подключён" : "На устройстве")</span>
            <button class="icon-button" @onclick='() => Navigate("settings")' aria-label="Открыть настройки" title="Настройки">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 8.5a3.5 3.5 0 1 0 0 7 3.5 3.5 0 0 0 0-7Z" /><path d="m19.4 15 .1.1a1.7 1.7 0 0 1-2.4 2.4l-.1-.1a1.7 1.7 0 0 0-2.9 1.2v.2a1.7 1.7 0 0 1-3.4 0v-.2a1.7 1.7 0 0 0-2.9-1.2l-.1.1a1.7 1.7 0 1 1-2.4-2.4l.1-.1a1.7 1.7 0 0 0-1.2-2.9H4a1.7 1.7 0 0 1 0-3.4h.2a1.7 1.7 0 0 0 1.2-2.9l-.1-.1a1.7 1.7 0 1 1 2.4-2.4l.1.1a1.7 1.7 0 0 0 2.9-1.2V2a1.7 1.7 0 0 1 3.4 0v.2a1.7 1.7 0 0 0 2.9 1.2l.1-.1a1.7 1.7 0 1 1 2.4 2.4l-.1.1a1.7 1.7 0 0 0 1.2 2.9h.2a1.7 1.7 0 0 1 0 3.4h-.2a1.7 1.7 0 0 0-1.2 2.9Z" /></svg>
            </button>
        </div>
    </header>

    <main id="main-content" class="main-content">
        @if (tab == "plan")
        {
            <section class="screen-heading">
                <div>
                    <p class="eyebrow">МОСКОВСКОЕ ВРЕМЯ</p>
                    <h1>Планы</h1>
                    <p class="screen-subtitle">Ваш ритм на каждый день.</p>
                </div>
                <button class="today-button" @onclick="GoToday">Сегодня</button>
            </section>

            <div class="plan-shortcuts">
                <button class="secondary-button" @onclick="OpenRecurrenceManager">Повторы <span>@recurrences.Count</span></button>
                <button class="secondary-button" @onclick="OpenVacationManager">Отпуска и исключения <span>@vacations.Count</span></button>
            </div>

            <div class="calendar-toolbar">
                <div class="segmented-control" role="group" aria-label="Вид календаря">
                    <button class="@(monthView ? "" : "selected")" @onclick="() => monthView = false" aria-pressed="@(!monthView)">Неделя</button>
                    <button class="@(monthView ? "selected" : "")" @onclick="() => monthView = true" aria-pressed="@monthView">Месяц</button>
                </div>
                <div class="period-controls">
                    <button class="icon-button small" @onclick="() => ShiftPeriod(-1)" aria-label="Предыдущий @(monthView ? "месяц" : "неделя")">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m15 18-6-6 6-6" /></svg>
                    </button>
                    <strong class="period-title">@selectedDate.ToString("MMMM yyyy", culture)</strong>
                    <button class="icon-button small" @onclick="() => ShiftPeriod(1)" aria-label="Следующий @(monthView ? "месяц" : "неделя")">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 18 6-6-6-6" /></svg>
                    </button>
                </div>
            </div>

            @if (!monthView)
            {
                <div class="week-strip" aria-label="Дни недели">
                    @foreach (var date in WeekDays())
                    {
                        var count = CountTasksOn(date);
                        var leave = VacationsOn(date);
                        <button class="week-day @(date == selectedDate ? "selected" : "") @(date == LocalStore.Today ? "is-today" : "") @(leave.Count > 0 ? "has-vacation" : "")" @onclick="() => SelectDate(date)" aria-pressed="@(date == selectedDate)" aria-label="@CalendarDayLabel(date, count, leave)" title="@VacationTooltip(leave)">
                            <span class="week-day-name">@date.ToString("ddd", culture)</span>
                            <span class="week-day-number">@date.Day</span>
                            <span class="week-day-footer">
                                @if (count > 0) { <span class="week-day-count">@count</span> }
                                @if (leave.Count > 0) { <i class="week-vacation-mark" aria-hidden="true"></i> }
                                @if (count == 0 && leave.Count == 0) { <span class="week-day-spacer"></span> }
                            </span>
                        </button>
                    }
                </div>
            }
            else
            {
                <div class="month-calendar" role="grid" aria-label="@selectedDate.ToString("MMMM yyyy", culture)">
                    <div class="month-weekdays" role="row">
                        @foreach (var day in weekdayHeaders) { <span role="columnheader">@day</span> }
                    </div>
                    <div class="month-days">
                        @foreach (var date in MonthDays())
                        {
                            var count = CountTasksOn(date);
                            var leave = VacationsOn(date);
                            <button role="gridcell" class="month-day @(date.Month != selectedDate.Month ? "outside-month" : "") @(date == selectedDate ? "selected" : "") @(date == LocalStore.Today ? "is-today" : "") @(leave.Count > 0 ? "has-vacation" : "")" @onclick="() => SelectDate(date)" aria-pressed="@(date == selectedDate)" aria-label="@CalendarDayLabel(date, count, leave)" title="@VacationTooltip(leave)">
                                <span>@date.Day</span>
                                @if (count > 0 || leave.Count > 0)
                                {
                                    <span class="month-day-indicators" aria-hidden="true">
                                        @if (count > 0) { <i class="month-day-mark"></i> }
                                        @if (leave.Count > 0) { <i class="month-vacation-mark"></i> }
                                    </span>
                                }
                            </button>
                        }
                    </div>
                </div>
            }

            @if (VisibleCalendarVacations().Count > 0)
            {
                <div class="calendar-legend" aria-label="Обозначения календаря">@if (monthView) { <span><i class="legend-task-mark" aria-hidden="true"></i>Есть дела</span> }<span><i class="month-vacation-mark" aria-hidden="true"></i>Период отсутствия</span></div>
            }

            <section class="day-section" aria-labelledby="selected-day-title">
                <div class="day-summary">
                    <div>
                        <p class="eyebrow">@(selectedDate == LocalStore.Today ? "СЕГОДНЯ" : "ВЫБРАННЫЙ ДЕНЬ")</p>
                        <h2 id="selected-day-title" class="day-title">@selectedDate.ToString("dddd, d MMMM", culture)</h2>
                    </div>
                    @if (SelectedDayTasks.Count > 0)
                    {
                        <div class="day-progress" role="progressbar" aria-label="Выполнение дел" aria-valuemin="0" aria-valuemax="@SelectedDayTasks.Count" aria-valuenow="@SelectedDayTasks.Count(x => x.Done)">
                            <span>@SelectedDayTasks.Count(x => x.Done) из @SelectedDayTasks.Count</span>
                            <div class="progress-track"><span style="width:@ProgressPercent%"></span></div>
                        </div>
                    }
                </div>

                @if (VacationsOn(selectedDate) is { Count: > 0 } selectedLeave)
                {
                    <div class="selected-vacation-note"><span class="week-vacation-mark" aria-hidden="true"></span><div><strong>Период отсутствия</strong><span>@VacationTooltip(selectedLeave)</span></div></div>
                }

                @if (SelectedDayTasks.Count == 0)
                {
                    <div class="empty-state">
                        <div class="empty-icon" aria-hidden="true">
                            <svg viewBox="0 0 48 48"><path d="M14 8v8m20-8v8M9 19h30M12 12h24a3 3 0 0 1 3 3v22a3 3 0 0 1-3 3H12a3 3 0 0 1-3-3V15a3 3 0 0 1 3-3Z" /><path d="m18 29 4 4 9-10" /></svg>
                        </div>
                        <h3>Здесь пока свободно</h3>
                        <p>Добавьте дело или оставьте день таким, как он есть.</p>
                        <button class="secondary-button" @onclick="() => AddAt(selectedDate)">Добавить первое дело</button>
                    </div>
                }
                else
                {
                    <div class="task-list">
                        @foreach (var item in SelectedDayTasks)
                        {
                            <article class="task-card @(item.Done ? "completed" : "")">
                                <button class="task-check" @onclick="() => Toggle(item)" disabled="@(ScheduledLog(item)?.Finished == true)" aria-pressed="@item.Done" aria-label="@(item.Done ? "Отметить незавершённым" : "Отметить выполненным"): @item.Title">
                                    @if (item.Done)
                                    {
                                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m5 12 4.5 4.5L19 7" /></svg>
                                    }
                                </button>
                                <div class="task-content">
                                    <div class="task-meta">
                                        @if (!string.IsNullOrWhiteSpace(item.Time))
                                        {
                                            <span class="time-label"><svg viewBox="0 0 20 20" aria-hidden="true"><circle cx="10" cy="10" r="7" /><path d="M10 6v4l2.5 1.5" /></svg>@FormatTaskTime(item.Time)</span>
                                        }
                                        else { <span class="all-day-label">Без времени</span> }
                                        @if (item.Done) { <span class="done-label">Выполнено</span> }
                                        @if (item.SeriesId is not null) { <span class="recurring-label">Повтор</span> }
                                        @if (item.WorkoutDayId is not null) { <span class="recurring-label">Тренировка</span> }
                                    </div>
                                    <button class="task-title" @onclick="() => Edit(item)">@item.Title</button>
                                    <div class="task-actions">
                                        <button @onclick="() => OpenMove(item)">Перенести</button>
                                        <button @onclick="() => Edit(item)">@(item.SeriesId is null ? "Изменить" : "Серия")</button>
                                        @if (item.SeriesId is not null) { <button @onclick="() => SkipOccurrence(item)">Пропустить</button> }
                                        @if (item.WorkoutDayId is not null) { <button class="primary-inline" @onclick="() => StartScheduled(item)">@(ScheduledLog(item) is { Finished: true } ? "Результат" : ScheduledLog(item) is null ? "Начать тренировку" : "Продолжить")</button> }
                                    </div>
                                </div>
                            </article>
                        }
                    </div>
                }
                <button class="primary-button add-task-button" @onclick="() => AddAt(selectedDate)">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14" /></svg>
                    Добавить дело
                </button>
            </section>
        }
        else if (tab == "notes")
        {
            <section class="screen-heading">
                <div><p class="eyebrow">МЫСЛИ ПОД РУКОЙ</p><h1>Заметки</h1><p class="screen-subtitle">Тексты и идеи, которые хочется сохранить.</p></div>
                <button class="round-action" @onclick="NewNote" aria-label="Новая заметка" title="Новая заметка"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14" /></svg></button>
            </section>
            <label class="search-field">
                <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.8" cy="10.8" r="6.8" /><path d="m16 16 4 4" /></svg>
                <input aria-label="Поиск по заметкам" placeholder="Найти заметку" @bind="search" @bind:event="oninput" />
                @if (!string.IsNullOrWhiteSpace(search)) { <button class="clear-search" @onclick='() => search = ""' aria-label="Очистить поиск">×</button> }
            </label>
            @if (!VisibleNotes.Any())
            {
                <div class="empty-state notes-empty">
                    <div class="empty-icon" aria-hidden="true"><svg viewBox="0 0 48 48"><path d="M13 8h17l7 7v25H13a3 3 0 0 1-3-3V11a3 3 0 0 1 3-3Z" /><path d="M29 8v8h8M17 24h16M17 31h12" /></svg></div>
                    <h3>@(string.IsNullOrWhiteSpace(search) ? "Сохраните то, что важно" : "Ничего не найдено")</h3>
                    <p>@(string.IsNullOrWhiteSpace(search) ? "Идеи, ссылки и мысли останутся рядом даже без сети." : "Попробуйте другой запрос.")</p>
                    @if (string.IsNullOrWhiteSpace(search)) { <button class="secondary-button" @onclick="NewNote">Создать заметку</button> }
                </div>
            }
            else
            {
                @if (VisibleNotes.Any(x => x.Pinned)) { <h2 class="list-heading">Закреплённое</h2> }
                <div class="notes-list">
                    @foreach (var note in VisibleNotes)
                    {
                        <article class="note-card @(note.Pinned ? "pinned" : "")">
                            <div class="note-meta">
                                <span>@note.Created.ToLocalTime().ToString("d MMM yyyy · HH:mm", culture)</span>
                                @if (note.Pinned) { <span class="pinned-label"><svg viewBox="0 0 20 20" aria-hidden="true"><path d="m7 3 6 0 1 5 3 3-5 1-2 5-2-5-5-1 3-3 1-5Z" /></svg>Закреплено</span> }
                            </div>
                            <p class="note-body">@note.Text</p>
                            <div class="note-actions">
                                <button @onclick="() => EditNote(note)">Изменить</button>
                                <button @onclick="() => Pin(note)">@(note.Pinned ? "Открепить" : "Закрепить")</button>
                                <button class="delete-action" @onclick="() => AskDeleteNote(note)">Удалить</button>
                            </div>
                        </article>
                    }
                </div>
            }
        }
        else if (tab == "learn")
        {
            <section class="screen-heading">
                <div><p class="eyebrow">ОДИН ШАГ ГЛУБЖЕ</p><h1>Учёба</h1><p class="screen-subtitle">Короткая теория, которую можно применить.</p></div>
            </section>
            @if (availableLessons.Count > 0)
            {
                <div class="lesson-picker" role="group" aria-label="Уроки, сохранённые на устройстве">
                    @foreach (var lesson in availableLessons)
                    {
                        <button class="lesson-option @(activeLesson?.Id == lesson.Id && activeLesson?.Version == lesson.Version ? "selected" : "")"
                                aria-pressed="@(activeLesson?.Id == lesson.Id && activeLesson?.Version == lesson.Version)"
                                @onclick="() => SelectLesson(lesson.Id, lesson.Version)">
                            <span>@lesson.Date.ToString("ddd, d MMM", culture) · v@lesson.Version</span>
                            <strong>@lesson.Title</strong>
                            <small>@lesson.EstimatedMinutes минут</small>
                        </button>
                    }
                </div>
            }
            else
            {
                <div class="lesson-cache-empty">Опубликованные уроки появятся здесь после подключения синхронизации. Демонстрационный урок ниже доступен офлайн.</div>
            }
            <article class="lesson-card">
                <div class="lesson-topline"><span class="lesson-chip">@(activeLesson is null ? "Демонстрационный урок" : "Опубликованный урок")</span><span class="lesson-duration"><svg viewBox="0 0 20 20" aria-hidden="true"><circle cx="10" cy="10" r="7" /><path d="M10 6v4l2.5 1.5" /></svg>@LessonDuration минут</span></div>
                <h2>@LessonTitle</h2>
                <p class="lesson-intro">@LessonIntro</p>
                <div class="lesson-theory">
                    <h3>Как это работает</h3>
                    <div class="lesson-theory-text">@LessonTheory</div>
                </div>
                @if (!string.IsNullOrWhiteSpace(activeLesson?.SelfCheck))
                {
                    <details class="rubric-details">
                        <summary>Ориентиры для самопроверки</summary>
                        <div class="lesson-theory-text">@activeLesson.SelfCheck</div>
                    </details>
                }
                @foreach (var source in CurrentLessonSources)
                {
                    <button class="source-link" @onclick="() => OpenSource(source.Url)">
                        <span class="source-mark">MS</span><span><small>@(source.Section ?? "Первоисточник · проверено " + source.VerifiedOn.ToString("d MMM yyyy", culture))</small><strong>@source.Title</strong></span><svg viewBox="0 0 20 20" aria-hidden="true"><path d="M7 4h9v9M16 4 8 12M14 11v5H4V6h5" /></svg>
                    </button>
                }
                <label class="lesson-read"><input type="checkbox" checked="@LessonRead" @onchange="ReadLesson" /><span class="custom-check"></span><span>Я прочитал теорию</span></label>
            </article>

            @if (LessonPractice is { Length: > 0 } practice)
            {
                <article class="practice-card">
                    <div class="card-eyebrow">ПРОВЕРЬТЕ ПОНИМАНИЕ</div>
                    <h2>Продумайте сценарий</h2>
                    <p>@practice</p>
                    <label class="field-label" for="lesson-answer">Ваше объяснение</label>
                    <textarea id="lesson-answer" class="text-area" placeholder="Запишите ход мысли — черновик сохраняется автоматически." value="@answerDraft" @oninput="SaveAnswer" @onchange="CommitAnswer" aria-describedby="answer-help"></textarea>
                    <div id="answer-help" class="field-hint">Можно вернуться позже. Ответ остаётся на устройстве.</div>
                    <label class="field-label" for="lesson-evidence">Что теперь можете объяснить или применить?</label>
                    <textarea id="lesson-evidence" class="text-area" placeholder="Коротко зафиксируйте свидетельство понимания." value="@evidenceDraft" @oninput="SaveEvidence" @onchange="CommitEvidence"></textarea>
                    @if (activeLesson is null)
                    {
                        <details class="rubric-details">
                            <summary>Ориентиры для самопроверки</summary>
                            <ul><li>Токен проходит до I/O.</li><li>Отмена не маскируется под сетевой сбой.</li><li>Ресурсы освобождаются при любом исходе.</li></ul>
                        </details>
                    }
                </article>
            }
            else if (IsTheoryOnly)
            {
                <div class="sunday-note"><span aria-hidden="true">☼</span><p>Воскресный урок — только теория, без обязательной практики.</p></div>
            }

            <article class="practice-card lesson-notes-card">
                <div class="card-eyebrow">ДЛЯ СЕБЯ · НЕОБЯЗАТЕЛЬНО</div>
                <h2>Заметки к уроку</h2>
                <textarea id="lesson-notes" class="text-area" aria-label="Заметки к уроку" placeholder="Сохраните вопрос, пример или мысль — без обязательного задания." value="@notesDraft" @oninput="SaveNotes" @onchange="CommitNotes"></textarea>
                <div class="field-hint">Заметки сохраняются на устройстве вместе с версией урока.</div>
                <button class="secondary-button codex-button" @onclick="CopyLesson">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="8" y="8" width="12" height="12" rx="2" /><path d="M16 8V5a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h3" /></svg>
                    Подготовить пакет для Codex
                </button>
            </article>

            @if (shareText is not null)
            {
                <article class="share-card">
                    <div class="card-eyebrow">ПАКЕТ ДЛЯ ОБСУЖДЕНИЯ</div><h2>Проверьте перед передачей</h2>
                    <p>В пакет попадут урок, источник и ваш ответ. Измените текст, если хотите что-то убрать.</p>
                    <textarea class="text-area share-area" aria-label="Текст пакета для Codex" @bind="shareText"></textarea>
                    <div class="button-row"><button class="secondary-button" @onclick="CopyPackage">Копировать</button><button class="primary-button" @onclick="SharePackage">Поделиться</button></div>
                </article>
            }
        }
        else if (tab == "workouts")
        {
            <section class="screen-heading">
                <div><p class="eyebrow">СИЛА В СВОЁМ РИТМЕ</p><h1>Тренировки</h1><p class="screen-subtitle">План, запись подходов и история занятий.</p></div>
                <button class="round-action" @onclick="NewTrainingDay" aria-label="Добавить день программы" title="Добавить день программы"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14" /></svg></button>
            </section>
            <div class="workout-summary"><span class="summary-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M6 8v8M3 10v4M18 8v8M21 10v4M6 12h12" /></svg></span><div><strong>@training.Count планов</strong><small>Занятия можно проходить в любом порядке</small></div></div>

            @if (ActiveLogs.Any())
            {
                <h2 class="list-heading">Продолжить тренировку</h2>
                @foreach (var log in ActiveLogs)
                {
                    var template = WorkoutDocuments.ReadPlan(log.DayId, log.Name, log.Snapshot);
                    var recorded = WorkoutDocuments.ReadLog(log.Results);
                    <article class="active-session">
                        <div class="session-state"><span class="status-dot"></span>В процессе · @FormatMoscow(log.Started)</div>
                        <h2>@log.Name</h2>
                        @foreach (var exercise in template.Exercises)
                        {
                            <section class="session-exercise">
                                <div class="session-exercise-heading"><h3>@exercise.Name</h3><span>@FormatTargets(exercise)</span></div>
                                @if (!string.IsNullOrWhiteSpace(exercise.Note)) { <p class="exercise-note">@exercise.Note</p> }
                                @for (var setIndex = 0; setIndex < exercise.Sets.Count; setIndex++)
                                {
                                    var target = exercise.Sets[setIndex];
                                    var actual = recorded.Sets.FirstOrDefault(x => x.SetId == target.Id);
                                    <div class="session-set">
                                        <div class="session-set-target"><span>Подход @(setIndex + 1)</span><strong>@WorkoutDocuments.FormatTarget(target)</strong></div>
                                        <label><span>Повторы</span><input type="number" min="0" max="1000" inputmode="numeric" value="@ResultRepetitions(actual)" @onchange="e => UpdateSessionSet(log, target, e, true)" /></label>
                                        <label><span>Вес</span><input type="number" min="0" max="100000" step="0.1" inputmode="decimal" value="@ResultLoad(actual)" @onchange="e => UpdateSessionSet(log, target, e, false)" /></label>
                                        <label class="set-complete"><input type="checkbox" checked="@(actual?.Completed ?? false)" @onchange="e => UpdateSessionCompleted(log, target, e)" /><span>Готово</span></label>
                                    </div>
                                }
                            </section>
                        }
                        <label class="field-label" for="result-notes-@log.Id">Заметка по тренировке</label>
                        <textarea id="result-notes-@log.Id" class="text-area result-area" placeholder="Самочувствие, техника, что учесть в следующий раз" value="@recorded.Notes" @onchange="e => UpdateSessionNotes(log, e)"></textarea>
                        <button class="primary-button finish-button" @onclick="() => Finish(log)">Завершить занятие</button>
                    </article>
                }
            }

            <div class="subsection-heading"><h2 class="list-heading">Программа</h2><span>@training.Count @(training.Count == 1 ? "день" : training.Count is >= 2 and <= 4 ? "дня" : "дней")</span></div>
            @if (!training.Any())
            {
                <div class="empty-state workout-empty">
                    <div class="empty-icon" aria-hidden="true"><svg viewBox="0 0 48 48"><path d="M8 18v12m7-18v24m18-24v24m7-18v12M15 24h18" /></svg></div>
                    <h3>Добавьте первый день</h3><p>Запишите упражнения, подходы, повторы и рабочие веса.</p>
                    <button class="secondary-button" @onclick="NewTrainingDay">Создать план</button>
                </div>
            }
            else
            {
                <div class="training-list">
                    @foreach (var day in training)
                    {
                        var template = WorkoutDocuments.ReadPlan(day.Id, day.Name, day.Exercises);
                        <article class="training-card">
                            <div class="training-card-heading"><div><span class="training-kicker">ПЛАН ЗАНЯТИЯ</span><h2>@day.Name</h2></div><button class="icon-button small" @onclick="() => EditDay(day)" aria-label="Изменить план: @day.Name"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m14 5 5 5M4 20l4.5-1 11-11a2.1 2.1 0 0 0-3-3l-11 11L4 20Z" /></svg></button></div>
                            @if (template.Exercises.Count == 0)
                            {
                                <p class="field-hint">Упражнения ещё не добавлены.</p>
                            }
                            else
                            {
                                <div class="exercise-list">
                                    @foreach (var exercise in template.Exercises)
                                    {
                                        <div class="exercise-row structured-exercise"><span class="exercise-bullet"></span><span><strong>@exercise.Name</strong><small>@FormatTargets(exercise)</small>@if (!string.IsNullOrWhiteSpace(exercise.Note)) { <small>@exercise.Note</small> }</span></div>
                                    }
                                </div>
                            }
                            <div class="training-card-actions"><button class="secondary-button" @onclick="() => EditDay(day)">Изменить план</button><button class="secondary-button" @onclick="() => OpenWorkoutSchedule(day)">Запланировать</button><button class="primary-button" @onclick="() => Start(day)" disabled="@(template.Exercises.Count == 0)">Начать</button></div>
                        </article>
                    }
                </div>
            }

            @if (FinishedLogs.Any())
            {
                <details class="history-details"><summary>История занятий <span>@FinishedLogs.Count</span></summary>
                    @foreach (var log in FinishedLogs)
                    {
                        <article class="history-card"><div class="history-date">@FormatMoscow(log.Started) · Завершено</div><h3>@log.Name</h3>@if (!string.IsNullOrWhiteSpace(FormatWorkoutLog(log))) { <p class="history-results">@FormatWorkoutLog(log)</p> }<button class="text-button" @onclick="() => EditResults(log)">Изменить результаты</button></article>
                    }
                </details>
            }
        }
        else
        {
            <section class="screen-heading"><div><p class="eyebrow">PERSONALFLOW</p><h1>Настройки</h1><p class="screen-subtitle">Управление приложением и данными.</p></div></section>
            var syncStatus = Store.SyncStatus;
            var epochConflicts = Store.GetSyncEpochConflicts();
            <article class="settings-card">
                <div class="settings-card-top"><span class="settings-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8" r="4" /><path d="M4 21a8 8 0 0 1 16 0" /></svg></span><div><h2>Аккаунт и синхронизация</h2><p>Вход проходит в системном браузере с подтверждением вторым фактором.</p></div></div>
                <label class="field-label" for="identity-authority">Сервер входа (Identity)</label>
                <input id="identity-authority" class="text-input" type="url" inputmode="url" autocomplete="url" placeholder="https://identity.example.org/" @bind="identityAuthorityDraft" disabled="@authSignedIn" />
                <label class="field-label" for="life-api">Планы и заметки</label>
                <input id="life-api" class="text-input" type="url" inputmode="url" autocomplete="url" placeholder="https://life.example.org/" @bind="lifeApiDraft" disabled="@authSignedIn" />
                <label class="field-label" for="learning-api">Обучение</label>
                <input id="learning-api" class="text-input" type="url" inputmode="url" autocomplete="url" placeholder="https://learning.example.org/" @bind="learningApiDraft" disabled="@authSignedIn" />
                <p class="settings-note">После настройки VPS укажите адреса сервисов. Принимаются только HTTPS адреса; пароль и коды остаются в системном браузере.</p>
                <div class="button-row account-actions">
                    <button class="secondary-button" @onclick="SaveServerEndpoints" disabled="@authBusy">Сохранить адреса</button>
                    @if (authSignedIn)
                    {
                        <button class="primary-button" @onclick="SynchronizeNow" disabled="@authBusy">@(authBusy ? "Синхронизация…" : "Синхронизировать")</button>
                        <button class="secondary-button" @onclick="SignOut" disabled="@authBusy">Выйти</button>
                    }
                    else
                    {
                        <button class="primary-button" @onclick="ConnectAccount" disabled="@authBusy">@(authBusy ? "Открываем вход…" : "Подключить аккаунт")</button>
                    }
                </div>
                @if (!string.IsNullOrWhiteSpace(authMessage)) { <p class="settings-note" role="status">@authMessage</p> }
            </article>
            <article class="settings-card">
                <div class="settings-card-top"><span class="settings-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3v2M12 19v2M3 12h2m14 0h2M5.64 5.64l1.42 1.42m9.88 9.88 1.42 1.42m0-12.72-1.42 1.42m-9.88 9.88-1.42 1.42" /><circle cx="12" cy="12" r="5" /></svg></span><div><h2>Данные на устройстве</h2><p>Изменения записываются локально в SQLite.</p></div></div>
                <div class="settings-row"><span>Статус сервера</span><strong class="@(authSignedIn ? "reminder-enabled" : "pending-badge")">@(authSignedIn ? "Аккаунт подключён" : Identity.IsConfigured ? "Требуется вход" : "Адреса не заданы")</strong></div>
                <div class="settings-row"><span>Синхронизация</span><strong>@backgroundSyncStatus.StateLabel</strong></div>
                <p class="settings-note">@backgroundSyncStatus.LastSyncLabel. Автоматическая попытка запускается при открытии приложения и возвращении в него.</p>
                @if (!string.IsNullOrWhiteSpace(backgroundSyncStatus.Notice)) { <p class="settings-note" role="status">@backgroundSyncStatus.Notice</p> }
                <div class="settings-row"><span>Локальная очередь изменений</span><strong>@syncStatus.Pending</strong></div>
                <div class="settings-row"><span>Конфликты, требующие решения</span><strong>@syncStatus.Conflicts</strong></div>
                <div class="settings-row"><span>Обнаруженные смены эпохи сервера</span><strong>@epochConflicts.Count</strong></div>
                <p class="settings-note">Изменения сначала сохраняются локально. При отсутствии сети очередь остаётся на устройстве и отправляется при следующем успешном подключении.</p>
                @if (syncStatus.Conflicts > 0) { <p class="settings-note" role="status">Локальные данные сохранены. Изменения ждут вашего решения.</p> }
                @if (epochConflicts.Count > 0)
                {
                    <section class="sync-conflict-inbox" aria-labelledby="epoch-recovery-title">
                        <h3 id="epoch-recovery-title">Сверка после восстановления сервера</h3>
                        <p class="settings-note">История сервера изменилась. Локальные планы и ответы сохранены. Сверка перечитает сервер, попробует объединить независимые изменения и покажет конфликтующие поля для выбора. Старые версии конфликтов останутся доступны в архиве только для просмотра.</p>
                        @foreach (var conflict in epochConflicts)
                        {
                            <article class="sync-conflict-card">
                                <div><strong>@(conflict.Service == "life" ? "Планы и заметки" : "Обучение")</strong><span>@(conflict.RecoveryStarted ? conflict.SnapshotComplete ? "Снимок получен; отправляются локальные правки" : "Снимок сервера загружается; сверка продолжится при следующем подключении" : "Локальная очередь ждёт сверки")</span></div>
                            </article>
                        }
                        <button class="primary-button full-button" @onclick="RecoverSyncEpochs" disabled="@(authBusy || backgroundSyncStatus.IsRunning || !authSignedIn)">@(authBusy ? "Сверяем версии…" : "Сверить сервер и сохранить локальные правки")</button>
                    </section>
                }
                @if (syncConflicts.Count > 0)
                {
                    <section class="sync-conflict-inbox" aria-labelledby="conflict-inbox-title">
                        <h3 id="conflict-inbox-title">Конфликты данных</h3>
                        @foreach (var conflict in syncConflicts)
                        {
                            <article class="sync-conflict-card">
                                <div><strong>@ConflictTitle(conflict)</strong><span>@(conflict.ArchivedEpoch ? "Архив после смены эпохи · только просмотр" : conflict.ResolutionPending ? "Решение сохранено на устройстве и ожидает отправки" : (conflict.Service == "life" ? "Планы и заметки" : "Обучение") + " · ревизия сервера " + conflict.ServerRevision)</span></div>
                                <button class="secondary-button" @onclick="() => OpenConflict(conflict)" disabled="@(conflict.ResolutionPending || authBusy || backgroundSyncStatus.IsRunning)">@(conflict.ArchivedEpoch ? "Открыть архив" : conflict.ResolutionPending ? "Ожидает синхронизации" : selectedConflict?.Id == conflict.Id ? "Открыто" : "Сравнить версии")</button>
                            </article>
                        }
                    </section>
                }
                @if (selectedConflict is { } currentConflict)
                {
                    <section class="sync-conflict-detail" aria-labelledby="conflict-detail-title">
                        <div class="sheet-heading"><div><p class="eyebrow">@(currentConflict.ArchivedEpoch ? "АРХИВ · ТОЛЬКО ПРОСМОТР" : "ТРЕБУЕТ РЕШЕНИЯ")</p><h3 id="conflict-detail-title">@ConflictTitle(currentConflict)</h3></div><button class="icon-button small" @onclick="CloseConflict" aria-label="Закрыть сравнение">×</button></div>
                        @if (currentConflict.ArchivedEpoch)
                        {
                            <p class="settings-note">Это сохранённый снимок конфликта до восстановления сервера. Он доступен для сравнения; новое решение принимайте в актуальном конфликте после сверки.</p>
                            @if (currentConflict.LocalDeleted || currentConflict.ServerDeleted)
                            {
                                <p class="settings-note">Состояние удаления — локально: @(currentConflict.LocalDeleted ? "удалено" : "редакция сохранена"); на сервере: @(currentConflict.ServerDeleted ? "удалено" : "редакция сохранена").</p>
                            }
                            @foreach (var field in conflictFields)
                            {
                                <article class="conflict-field-card">
                                    <h4>@field.Label</h4>
                                    <div class="conflict-value"><span>Исходное</span><p>@field.BaseText</p></div>
                                    <div class="conflict-value"><span>Сохранено на сервере</span><p>@field.ServerText</p></div>
                                    <div class="conflict-value"><span>Сохранено локально</span><p>@field.LocalText</p></div>
                                </article>
                            }
                        }
                        else
                        {
                        @if (currentConflict.LocalDeleted || currentConflict.ServerDeleted)
                        {
                            <div class="conflict-choice-actions">
                                <button class="secondary-button" @onclick='() => ResolveConflictVersion("server")'>Сервер: @ConflictStateLabel(currentConflict.ServerDeleted)</button>
                                <button class="secondary-button" @onclick='() => ResolveConflictVersion("local")'>Моё устройство: @ConflictStateLabel(currentConflict.LocalDeleted)</button>
                            </div>
                        }
                        @if (conflictFields.Count == 0 && !currentConflict.LocalDeleted && !currentConflict.ServerDeleted)
                        {
                            <p class="settings-note">Для этого конфликта не удалось выделить поля для объединения. Сохранённые версии не изменены.</p>
                        }
                        @if (conflictFields.Count > 0)
                        {
                            <div class="conflict-choice-actions">
                                <button class="secondary-button" @onclick='() => ChooseConflictVersion("server")'>Выбрать все серверные значения</button>
                                <button class="secondary-button" @onclick='() => ChooseConflictVersion("local")'>Выбрать мои значения</button>
                            </div>
                            @foreach (var field in conflictFields)
                            {
                                <article class="conflict-field-card">
                                    <h4>@field.Label</h4>
                                    <div class="conflict-value"><span>Исходное</span><p>@field.BaseText</p></div>
                                    <div class="conflict-value"><span>На сервере</span><p>@field.ServerText</p><button class="text-button @(field.Choice == "server" ? "chosen" : "")" aria-pressed='@(field.Choice == "server")' @onclick='() => field.Choice = "server"'>Оставить серверное</button></div>
                                    <div class="conflict-value"><span>Моё предложение</span><p>@field.LocalText</p><button class="text-button @(field.Choice == "local" ? "chosen" : "")" aria-pressed='@(field.Choice == "local")' @onclick='() => field.Choice = "local"'>Оставить моё</button></div>
                                    @if (field.IsEditable)
                                    {
                                        <label class="field-label">Объединённое значение
                                            @if (field.IsLongText)
                                            {
                                                <textarea class="text-area conflict-long-text" rows="5" @bind="field.ManualValue" @bind:event="oninput" @onfocus='() => field.Choice = "manual"'></textarea>
                                            }
                                            else
                                            {
                                                <input class="text-input" @bind="field.ManualValue" @bind:event="oninput" @onfocus='() => field.Choice = "manual"' />
                                            }
                                            @if (field.Choice == "manual") { <span class="conflict-custom-selected">Используется ваше значение</span> }
                                        </label>
                                    }
                                </article>
                            }
                            <div class="sheet-actions"><button class="primary-button" @onclick="ResolveSelectedConflict" disabled="@(authBusy || backgroundSyncStatus.IsRunning)">@(authBusy ? "Сохраняем…" : currentConflict.LocalDeleted || currentConflict.ServerDeleted ? "Сохранить редакцию и восстановить" : "Сохранить объединённый вариант")</button></div>
                        }
                        }
                    </section>
                }
            </article>
            <article class="settings-card">
                <div class="settings-card-top"><span class="settings-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M18 9a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9M10 21h4" /></svg></span><div><h2>Напоминания</h2><p>Локально на этом устройстве, без отправки расписания на сервер.</p></div></div>
                <div class="settings-row"><span>Уведомления</span><strong class="@(reminderStatus?.NotificationsAllowed == true ? "reminder-enabled" : "pending-badge")">@(reminderStatus?.NotificationsAllowed == true ? "Разрешены" : "Не разрешены")</strong></div>
                @if (reminderStatus?.NotificationsAllowed == true)
                {
                    <div class="settings-row"><span>Точное время</span><strong class="@(reminderStatus.ExactTimeAvailable ? "reminder-enabled" : "pending-badge")">@(reminderStatus.ExactTimeAvailable ? "Доступно" : "Ожидает разрешения")</strong></div>
                }
                <p class="settings-note">@(reminderStatus?.Description ?? "Проверяем системные разрешения.") Для дел со временем создаются уведомления за час и в указанное время. Время берётся из расписания PersonalFlow (Москва).</p>
                <button class="secondary-button reminder-button" @onclick="EnableReminders" disabled="@reminderRequesting">@(reminderRequesting ? "Проверяем…" : reminderStatus?.NotificationsAllowed == true ? "Обновить расписание" : "Настроить уведомления")</button>
            </article>
            <article class="settings-card">
                <div class="settings-card-top"><span class="settings-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 2" /></svg></span><div><h2>Часовой пояс</h2><p>Регулярные планы ориентируются на московское время.</p></div></div>
                <div class="settings-row"><span>Текущая зона</span><strong>Europe/Moscow</strong></div>
            </article>
            <p class="app-version">PersonalFlow · Версия 1.0</p>
        }

        @if (message is not null) { <div role="status" aria-live="polite" class="toast-message">@message</div> }
    </main>

    <nav class="bottom-nav" aria-label="Основные разделы">
        @foreach (var item in tabs)
        {
            <button class="nav-item @(tab == item.Key ? "active" : "")" @onclick="() => Navigate(item.Key)" aria-current="@(tab == item.Key ? "page" : null)">
                <span class="nav-icon" aria-hidden="true">
                    @if (item.Key == "plan") { <svg viewBox="0 0 24 24"><rect x="3.5" y="5" width="17" height="16" rx="3" /><path d="M8 3v4M16 3v4M4 10h16M8 14h.01M12 14h.01M16 14h.01M8 17h.01M12 17h.01" /></svg> }
                    else if (item.Key == "learn") { <svg viewBox="0 0 24 24"><path d="M3.5 5.5c3.7-.9 6.5-.3 8.5 1.5v13c-2-1.8-4.8-2.4-8.5-1.5v-13ZM20.5 5.5c-3.7-.9-6.5-.3-8.5 1.5v13c2-1.8 4.8-2.4 8.5-1.5v-13Z" /></svg> }
                    else if (item.Key == "notes") { <svg viewBox="0 0 24 24"><path d="M6 3.5h9l4 4V20a1.5 1.5 0 0 1-1.5 1.5h-11A1.5 1.5 0 0 1 5 20V5a1.5 1.5 0 0 1 1-1.5Z" /><path d="M14 4v5h5M8.5 13h7M8.5 16.5h7" /></svg> }
                    else { <svg viewBox="0 0 24 24"><path d="M3 9v6m4-9v12m10-12v12m4-9v6M7 12h10" /><path d="M2 10h2v4H2zm4-2h2v8H6zm10 0h2v8h-2zm4 2h2v4h-2z" /></svg> }
                </span>
                <span>@item.Name</span>
            </button>
        }
    </nav>
</div>

@if (recurrenceManager)
{
    <div class="sheet-backdrop" @onclick="CloseSheets">
        <section class="sheet-panel" role="dialog" aria-modal="true" aria-labelledby="recurrence-manager-title" @onclick:stopPropagation="true">
            <div class="sheet-grabber"></div>
            <div class="sheet-heading"><div><p class="eyebrow">ПЛАНЫ</p><h2 id="recurrence-manager-title">Повторяющиеся дела</h2></div><button class="icon-button" @onclick="CloseSheets" aria-label="Закрыть">×</button></div>
            <p class="field-hint">Перенос или пропуск меняет только выбранное вхождение. Настройка серии влияет на будущие даты.</p>
            @if (recurrences.Count == 0) { <div class="empty-state compact-empty"><h3>Повторов пока нет</h3><p>Создайте регулярное дело и выберите дни недели или месяца.</p></div> }
            <div class="recurrence-list">
                @foreach (var series in recurrences.OrderBy(x => x.Title, StringComparer.CurrentCulture))
                {
                    <button class="recurrence-card" @onclick="() => EditRecurrence(series.Id)">
                        <span class="recurrence-card-mark" aria-hidden="true">↻</span>
                        <span><strong>@series.Title</strong><small>@RecurrenceSummary(series) · с @series.StartsOn.ToString("d MMM yyyy", culture)</small>@if (series.ExclusionCategory is not null) { <small>Пропускать отпуск: @series.ExclusionCategory</small> }</span>
                        <span class="recurrence-chevron" aria-hidden="true">›</span>
                    </button>
                }
            </div>
            <button class="primary-button full-button" @onclick="NewRecurrence">Создать повтор</button>
            <button class="secondary-button full-button" @onclick="OpenVacationManager">Настроить отпуска</button>
        </section>
    </div>
}

@if (recurrenceEditor)
{
    <div class="sheet-backdrop" @onclick="CloseSheets">
        <section class="sheet-panel" role="dialog" aria-modal="true" aria-labelledby="recurrence-editor-title" @onclick:stopPropagation="true">
            <div class="sheet-grabber"></div>
            <div class="sheet-heading"><div><p class="eyebrow">ПОВТОРЯЮЩЕЕСЯ ДЕЛО · МОСКВА</p><h2 id="recurrence-editor-title">@(recurrenceId is null ? "Новый повтор" : "Изменить серию")</h2></div><button class="icon-button" @onclick="CloseSheets" aria-label="Закрыть">×</button></div>
            <label class="field-label" for="recurrence-title">Название дела</label><input id="recurrence-title" class="text-input" @bind="recurrenceTitle" maxlength="200" placeholder="Например, еженедельная встреча" />
            <label class="field-label" for="recurrence-time">Время · Москва</label><input id="recurrence-time" class="text-input" type="time" value="@recurrenceTime" @onchange="SetRecurrenceTime" />
            <label class="field-label" for="recurrence-pattern">Повторять</label>
            <select id="recurrence-pattern" class="text-input" value="@recurrencePattern" @onchange="SetRecurrencePattern">
                <option value="daily">Каждый день</option><option value="weekdays">По будням</option><option value="weekends">По выходным</option><option value="weekly">В выбранные дни недели</option><option value="monthly">В выбранный день месяца</option>
            </select>
            <div class="field-grid"><div><label class="field-label" for="recurrence-interval">Интервал</label><input id="recurrence-interval" class="text-input" type="number" min="1" max="365" value="@recurrenceInterval" @onchange="SetRecurrenceInterval" /></div><div class="interval-unit">@(recurrencePattern == "daily" ? "дней" : recurrencePattern == "monthly" ? "месяцев" : "недель")</div></div>
            @if (recurrencePattern == "weekly")
            {
                <div class="field-label">Дни недели</div>
                <div class="weekday-picker">
                    @foreach (var (day, name) in weekdayChoices)
                    {
                        <button class="weekday-choice @(recurrenceWeekdays.Contains(day) ? "selected" : "")" @onclick="() => ToggleWeekday(day)" aria-pressed="@recurrenceWeekdays.Contains(day)">@name</button>
                    }
                </div>
            }
            @if (recurrencePattern == "monthly")
            {
                <label class="field-label" for="recurrence-month-day">День месяца</label><input id="recurrence-month-day" class="text-input" type="number" min="1" max="31" value="@recurrenceMonthDay" @onchange="SetMonthDay" />
                <p class="field-hint">Если в месяце нет этого числа, повтора в этом месяце не будет.</p>
            }
