    string ConflictTitle(ClientSyncConflict conflict)
    {
        if (conflict.Service == "learning")
        {
            var lesson = availableLessons.FirstOrDefault(item => item.Id == conflict.LessonId && item.Version == conflict.ContentVersion);
            return lesson is null ? "Ответ к уроку" : $"Ответ: {lesson.Title}";
        }
        var version = ParseConflictObject(conflict.Server);
        if (!version.ContainsKey("Title")) version = ParseConflictObject(conflict.Local);
        var titleValue = version["Title"]?.ToString();
        return conflict.Kind switch
        {
            "PlanItem" => "Дело «" + (string.IsNullOrWhiteSpace(titleValue) ? "без названия" : titleValue) + "»",
            "NoteItem" => "Текстовая запись",
            "Recurrence" => "Правило повтора",
            "Vacation" => "Период отсутствия",
            "OccurrenceOverride" => "Вхождение повторяющегося дела",
            "TrainingDay" => "План тренировки",
            "TrainingLog" => "Запись тренировки",
            _ => "Запись PersonalFlow"
        };
    }

    static JsonObject ParseConflictObject(string? json) => string.IsNullOrWhiteSpace(json)
        ? new JsonObject()
        : JsonNode.Parse(json) as JsonObject ?? new JsonObject();

    static string FormatConflictValue(JsonNode? value)
    {
        if (value is null) return "—";
        if (value is JsonValue scalar && scalar.TryGetValue<string>(out var text))
            return string.IsNullOrEmpty(text) ? "Пусто" : text;
        if (value is JsonArray array) return array.Count == 0 ? "Пусто" : string.Join(", ", array.Select(FormatConflictValue));
        return value.ToJsonString();
    }

