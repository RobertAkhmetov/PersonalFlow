    void SaveTask()
    {
        if (string.IsNullOrWhiteSpace(title)) return;
        var id = taskId ?? Guid.NewGuid();
        var done = plans.FirstOrDefault(x => x.Id == id)?.Done ?? false;
        var date = DateOnly.FromDateTime(editDate);
        var workoutId = plans.FirstOrDefault(x => x.Id == id)?.WorkoutDayId;
        Store.Save(id, new PlanItem(id, title.Trim(), date, done, string.IsNullOrWhiteSpace(time) ? null : time, workoutId));
        selectedDate = date; Refresh(); CloseSheets(); ShowMessage("Дело сохранено на устройстве");
        RebuildReminders();
    }

    void Toggle(PlannedEntry item)
    {
        if (item.SeriesId is { } seriesId && item.OriginalDate is { } originalDate)
        {
            var previous = occurrenceOverrides.FirstOrDefault(x => x.SeriesId == seriesId && x.OriginalDate == originalDate);
            Store.Save(item.Id, new OccurrenceOverride(item.Id, seriesId, originalDate,
                previous?.MovedTo, !item.Done, previous?.Skipped ?? false));
        }
        else Store.Save(item.Id, new PlanItem(item.Id, item.Title, item.Date, !item.Done, item.Time, item.WorkoutDayId));
        Refresh();
        RebuildReminders();
    }

