@if (resultEditor)
{
    <div class="sheet-backdrop" @onclick="CloseSheets">
        <section class="sheet-panel" role="dialog" aria-modal="true" aria-labelledby="result-editor-title" @onclick:stopPropagation="true">
            <div class="sheet-grabber"></div>
            <div class="sheet-heading"><div><p class="eyebrow">ИСТОРИЯ ЗАНЯТИЙ</p><h2 id="result-editor-title">Результаты</h2></div><button class="icon-button" @onclick="CloseSheets" aria-label="Закрыть"><svg viewBox="0 0 24 24"><path d="m6 6 12 12M18 6 6 18" /></svg></button></div>
            @foreach (var log in logs.Where(x => x.Id == resultLogId))
            {
                var template = WorkoutDocuments.ReadPlan(log.DayId, log.Name, log.Snapshot);
                var recorded = WorkoutDocuments.ReadLog(log.Results);
                @foreach (var exercise in template.Exercises)
                {
                    <section class="session-exercise">
                        <div class="session-exercise-heading"><h3>@exercise.Name</h3><span>@FormatTargets(exercise)</span></div>
                        @foreach (var target in exercise.Sets)
                        {
                            var actual = recorded.Sets.FirstOrDefault(x => x.SetId == target.Id);
                            <div class="session-set">
                                <div class="session-set-target"><span>Подход</span><strong>@WorkoutDocuments.FormatTarget(target)</strong></div>
                                <label><span>Повторы</span><input type="number" min="0" max="1000" inputmode="numeric" value="@ResultRepetitions(actual)" @onchange="e => UpdateSessionSet(log, target, e, true)" /></label>
                                <label><span>Вес</span><input type="number" min="0" max="100000" step="0.1" inputmode="decimal" value="@ResultLoad(actual)" @onchange="e => UpdateSessionSet(log, target, e, false)" /></label>
                                <label class="set-complete"><input type="checkbox" checked="@(actual?.Completed ?? false)" @onchange="e => UpdateSessionCompleted(log, target, e)" /><span>Готово</span></label>
                            </div>
                        }
                    </section>
                }
                <label class="field-label" for="history-notes-@log.Id">Заметка</label><textarea id="history-notes-@log.Id" class="text-area note-editor-area" value="@recorded.Notes" @onchange="e => UpdateSessionNotes(log, e)"></textarea>
            }
            <button class="primary-button full-button" @onclick="SaveResults">Готово</button>
        </section>
    </div>
}

