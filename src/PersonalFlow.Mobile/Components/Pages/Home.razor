            <div class="sheet-heading"><div><p class="eyebrow">ПЛАН ТРЕНИРОВОК</p><h2 id="training-editor-title">@(dayId is null ? "Новый день" : "Изменить план")</h2></div><button class="icon-button" @onclick="CloseSheets" aria-label="Закрыть"><svg viewBox="0 0 24 24"><path d="m6 6 12 12M18 6 6 18" /></svg></button></div>
