    void OpenConflict(ClientSyncConflict conflict)
    {
        selectedConflict = conflict;
        var baseline = ParseConflictObject(conflict.Base);
        var server = ParseConflictObject(conflict.Server);
        var localPatch = ParseConflictObject(conflict.Local);
        var current = ParseConflictObject(Store.GetConflictCurrentBody(conflict));
        if (conflict.Service == "learning")
        {
            server["LessonId"] = conflict.LessonId;
            server["ContentVersion"] = conflict.ContentVersion;
            current["LessonId"] = conflict.LessonId;
            current["ContentVersion"] = conflict.ContentVersion;
        }
        else if (!server.ContainsKey("Id")) server["Id"] = conflict.EntityId;

        conflictServerVersion = (JsonObject)server.DeepClone();
        var localVersion = (JsonObject)server.DeepClone();
        foreach (var pair in localPatch)
        {
            current.TryGetPropertyValue(pair.Key, out var currentValue);
            baseline.TryGetPropertyValue(pair.Key, out var baseValue);
            var selectedLocalValue = conflict.HasLocalMutation && currentValue is not null && !JsonNode.DeepEquals(currentValue, baseValue)
                ? currentValue
                : pair.Value;
            localVersion[pair.Key] = selectedLocalValue?.DeepClone();
        }
        if (conflict.HasLocalMutation)
        {
            foreach (var pair in current)
            {
                baseline.TryGetPropertyValue(pair.Key, out var baseValue);
                if (!JsonNode.DeepEquals(pair.Value, baseValue)) localVersion[pair.Key] = pair.Value?.DeepClone();
            }
        }
        if (conflict.Service == "learning")
        {
            localVersion["LessonId"] = conflict.LessonId;
            localVersion["ContentVersion"] = conflict.ContentVersion;
        }
        conflictLocalVersion = localVersion;
        var keys = localPatch.Select(pair => pair.Key)
            .Concat(conflict.HasLocalMutation
                ? current.Where(pair => !JsonNode.DeepEquals(pair.Value, baseline[pair.Key])).Select(pair => pair.Key)
                : [])
            .Where(key => key is not ("Id" or "LessonId" or "ContentVersion"))
            .Distinct(StringComparer.Ordinal);
        conflictFields = [];
        foreach (var key in keys)
        {
            current.TryGetPropertyValue(key, out var currentValue);
            localPatch.TryGetPropertyValue(key, out var proposedValue);
            server.TryGetPropertyValue(key, out var serverValue);
            baseline.TryGetPropertyValue(key, out var baseValue);
            var localValue = conflict.HasLocalMutation && currentValue is not null && !JsonNode.DeepEquals(currentValue, baseValue)
                ? currentValue.DeepClone()
                : proposedValue?.DeepClone();
            if (JsonNode.DeepEquals(localValue, serverValue)) continue;
            var editable = localValue is JsonValue localScalar && localScalar.TryGetValue<string>(out _) ||
                           serverValue is JsonValue serverScalar && serverScalar.TryGetValue<string>(out _);
            conflictFields.Add(new ConflictFieldDraft
            {
                Key = key,
                Label = ConflictFieldLabel(key),
                BaseText = FormatConflictValue(baseValue),
                LocalText = FormatConflictValue(localValue),
                ServerText = FormatConflictValue(serverValue),
                LocalValue = localValue,
                ServerValue = serverValue?.DeepClone(),
                ManualValue = localValue is JsonValue textValue && textValue.TryGetValue<string>(out var text) ? text : string.Empty,
                IsEditable = editable,
                IsLongText = key is "Text" or "Answer" or "Notes" or "Evidence",
                Choice = "server"
            });
        }
    }

    void ChooseConflictVersion(string choice)
    {
        foreach (var field in conflictFields) field.Choice = choice;
    }

    async Task ResolveSelectedConflict()
    {
        if (selectedConflict is not { } conflict || conflictServerVersion is not { } server || conflictFields.Count == 0)
            return;
        var merged = (JsonObject)server.DeepClone();
        foreach (var field in conflictFields)
        {
            merged[field.Key] = field.Choice switch
            {
                "local" => field.LocalValue?.DeepClone(),
                "manual" when field.IsEditable => JsonValue.Create(field.ManualValue),
                _ => field.ServerValue?.DeepClone()
            };
        }
        await SaveConflictResolutionAsync(conflict, merged, delete: false);
    }

    async Task ResolveConflictVersion(string source)
    {
        if (selectedConflict is not { } conflict) return;
        var useServer = source == "server";
        var delete = useServer ? conflict.ServerDeleted : conflict.LocalDeleted;
        var version = useServer ? conflictServerVersion : conflictLocalVersion;
        if (!delete && version is null)
        {
            authMessage = "Не удалось сформировать выбранную версию. Исходные данные сохранены.";
            return;
        }
        await SaveConflictResolutionAsync(conflict, version, delete);
    }

    async Task SaveConflictResolutionAsync(ClientSyncConflict conflict, JsonObject? body, bool delete)
    {
        if (authBusy || BackgroundSync.Status.IsRunning)
        {
            authMessage = "Дождитесь завершения текущей синхронизации, затем сохраните решение.";
            return;
        }

        authBusy = true;
        try
        {
            Store.ResolveSyncConflict(conflict, body, delete);
            selectedConflict = null;
            conflictServerVersion = null;
            conflictLocalVersion = null;
            conflictFields = [];
            Refresh();
            ReloadSyncConflicts();
            try
            {
                await SynchronizeAfterConnectAsync();
                authMessage = "Решение передано на синхронизацию.";
            }
            catch (Exception ex)
            {
                authMessage = "Объединённый вариант сохранён на устройстве и будет отправлен позже. " + ex.Message;
            }
        }
        catch (Exception ex) { authMessage = "Не удалось сохранить решение: " + ex.Message; }
        finally { authBusy = false; }
    }

