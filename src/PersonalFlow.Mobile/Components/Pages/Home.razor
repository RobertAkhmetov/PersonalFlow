    void SaveWorkoutSchedule()
    {
        if (workoutScheduleDayId is not { } workoutId || training.All(day => day.Id != workoutId))
        { CloseSheets(); Refresh(); return; }
        var begins = DateOnly.FromDateTime(workoutScheduleStart);
        var normalizedTime = NormalizeTime(workoutScheduleTime);
        if (!string.IsNullOrWhiteSpace(workoutScheduleTime) && normalizedTime is null)
        { ShowMessage("Проверьте время начала"); return; }
        if (workoutScheduleMode == "weekly")
        {
            if (workoutScheduleInterval is < 1 or > 52)
            { ShowMessage("Интервал должен быть от 1 до 52 недель"); return; }
            if (workoutScheduleWeekdays.Count == 0)
            { ShowMessage("Выберите хотя бы один день недели"); return; }
            DateOnly? ends = workoutScheduleHasEnd ? DateOnly.FromDateTime(workoutScheduleEnd) : null;
            if (ends < begins) { ShowMessage("Дата окончания должна быть не раньше начала"); return; }
            var series = new Recurrence(Guid.NewGuid(), Guid.NewGuid(), $"Тренировка · {workoutScheduleName}", normalizedTime,
                begins, RecurrenceFrequency.Weekly, workoutScheduleInterval,
                workoutScheduleWeekdays.OrderBy(day => ((int)day + 6) % 7).ToArray(), [], ends,
                string.IsNullOrWhiteSpace(workoutScheduleCategory) ? null : workoutScheduleCategory,
                workoutId);
            Store.Save(series.Id, series);
        }
        else
        {
            var id = Guid.NewGuid();
            Store.Save(id, new PlanItem(id, $"Тренировка · {workoutScheduleName}", begins, false, normalizedTime, workoutId));
        }
        selectedDate = begins;
        Refresh(); CloseSheets(); ShowMessage("Тренировка добавлена в план"); RebuildReminders();
    }

