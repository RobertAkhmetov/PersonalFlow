    int CountTasksOn(DateOnly date) => EntriesFor(date, date).Count();

    IEnumerable<PlannedEntry> EntriesFor(DateOnly from, DateOnly through)
    {
        var manual = plans.Where(x => x.Date >= from && x.Date <= through)
            .Select(x => new PlannedEntry(x.Id, x.Title, x.Date, x.Done, x.Time, WorkoutDayId: x.WorkoutDayId));
        var repeated = RecurrenceProjection.Expand(from, through, recurrences, vacations, occurrenceOverrides);
        return manual.Concat(repeated)
            .Select(item => item.WorkoutDayId is not null && logs.Any(log => log.Id == item.Id && log.Finished)
                ? item with { Done = true }
                : item)
            .OrderBy(x => x.Date).ThenBy(x => x.Time ?? "99:99", StringComparer.Ordinal).ThenBy(x => x.Title, StringComparer.CurrentCulture);
    }

    IEnumerable<DateOnly> WeekDays()
    {
        var monday = selectedDate.AddDays(-(((int)selectedDate.DayOfWeek + 6) % 7));
        return Enumerable.Range(0, 7).Select(monday.AddDays);
    }

    IEnumerable<DateOnly> MonthDays()
    {
        var first = new DateOnly(selectedDate.Year, selectedDate.Month, 1);
        var start = first.AddDays(-(((int)first.DayOfWeek + 6) % 7));
        return Enumerable.Range(0, 42).Select(start.AddDays);
    }

