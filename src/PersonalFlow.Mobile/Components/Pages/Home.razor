    RecurrenceRule BuildRecurrenceRule()
    {
        var frequency = recurrencePattern == "daily" ? RecurrenceFrequency.Daily
            : recurrencePattern == "monthly" ? RecurrenceFrequency.Monthly : RecurrenceFrequency.Weekly;
        var weekdays = frequency == RecurrenceFrequency.Weekly ? recurrenceWeekdays.ToHashSet() : new HashSet<DayOfWeek>();
        var monthDays = frequency == RecurrenceFrequency.Monthly ? new HashSet<int> { recurrenceMonthDay } : new HashSet<int>();
        return new RecurrenceRule(DateOnly.FromDateTime(recurrenceStart), frequency, recurrenceInterval,
            weekdays, monthDays, recurrenceHasEnd ? DateOnly.FromDateTime(recurrenceEnd) : null,
            string.IsNullOrWhiteSpace(recurrenceCategory) ? null : recurrenceCategory);
    }

    IReadOnlyList<DateOnly> RecurrencePreview()
    {
        try
        {
            var rule = BuildRecurrenceRule();
            var end = DateOnly.FromDateTime(recurrenceStart).AddMonths(6);
            if (rule.EndsOn is { } endsOn && endsOn < end) end = endsOn;
            var exclusions = vacations.Select(x => new DateExclusion(x.Start, x.End, x.Category));
            return rule.Expand(rule.StartsOn, end, exclusions).Take(3).ToArray();
        }
        catch (ArgumentException) { return []; }
    }

    string RecurrenceSummary(Recurrence series)
    {
        var frequency = series.Frequency switch
        {
            RecurrenceFrequency.Daily => "ежедневно",
            RecurrenceFrequency.Monthly => $"ежемесячно · {string.Join(", ", series.MonthDays)}-е число",
            _ when series.Weekdays.ToHashSet().SetEquals([DayOfWeek.Monday, DayOfWeek.Tuesday, DayOfWeek.Wednesday, DayOfWeek.Thursday, DayOfWeek.Friday]) => "по будням",
            _ when series.Weekdays.ToHashSet().SetEquals([DayOfWeek.Saturday, DayOfWeek.Sunday]) => "по выходным",
            _ => string.Join(", ", series.Weekdays.Order().Select(WeekdayName))
        };
        return series.Interval == 1 ? frequency : $"каждые {series.Interval}: {frequency}";
    }

    string WeekdayName(DayOfWeek day) => day switch
    {
        DayOfWeek.Monday => "Пн", DayOfWeek.Tuesday => "Вт", DayOfWeek.Wednesday => "Ср",
        DayOfWeek.Thursday => "Чт", DayOfWeek.Friday => "Пт", DayOfWeek.Saturday => "Сб", _ => "Вс"
    };

    void SaveRecurrence()
    {
        if (string.IsNullOrWhiteSpace(recurrenceTitle)) { ShowMessage("Укажите название повтора"); return; }
        var id = recurrenceId ?? Guid.NewGuid();
        try
        {
            var rule = BuildRecurrenceRule();
            rule.Validate();
            if (!string.IsNullOrWhiteSpace(recurrenceCategory) && !vacations.Any(x => x.Category == recurrenceCategory))
            { ShowMessage("Сначала добавьте отпуск с выбранной категорией"); return; }
            var series = new Recurrence(id, id, recurrenceTitle.Trim(), NormalizeTime(recurrenceTime),
                rule.StartsOn, rule.Frequency, rule.Interval, rule.Weekdays.Order().ToArray(), rule.MonthDays.Order().ToArray(),
                rule.EndsOn, rule.ExclusionCategory, recurrenceWorkoutDayId);
            Store.Save(id, series); selectedDate = rule.StartsOn; Refresh(); recurrenceEditor = false; ShowMessage("Повтор сохранён"); RebuildReminders();
        }
        catch (ArgumentException)
        {
            ShowMessage("Проверьте период и выбранные дни повтора");
        }
    }

    string? NormalizeTime(string value) => string.IsNullOrWhiteSpace(value) ? null
        : TimeOnly.TryParse(value, CultureInfo.InvariantCulture, DateTimeStyles.None, out var parsed)
            ? parsed.ToString("HH:mm", CultureInfo.InvariantCulture) : null;

