            @if (exerciseDrafts.Count == 0) { <div class="field-hint">Добавьте упражнение, затем задайте цель каждого подхода.</div> }
            @for (var exerciseIndex = 0; exerciseIndex < exerciseDrafts.Count; exerciseIndex++)
            {
                var exercise = exerciseDrafts[exerciseIndex];
                <article class="exercise-editor-card">
                    <div class="exercise-editor-heading"><strong>Упражнение @(exerciseIndex + 1)</strong><div class="editor-reorder"><button class="icon-button small" @onclick="() => MoveExercise(exercise, -1)" disabled="@(exerciseIndex == 0)" aria-label="Выше">↑</button><button class="icon-button small" @onclick="() => MoveExercise(exercise, 1)" disabled="@(exerciseIndex == exerciseDrafts.Count - 1)" aria-label="Ниже">↓</button><button class="delete-action" @onclick="() => RemoveExercise(exercise)">Удалить</button></div></div>
                    <label class="field-label" for="exercise-name-@exercise.Id">Название упражнения</label><input id="exercise-name-@exercise.Id" class="text-input" @bind="exercise.Name" maxlength="120" placeholder="Например, Жим штанги лёжа" />
                    <div class="sets-heading"><span>Цели подходов</span><button class="text-button" @onclick="() => AddSet(exercise)">+ Подход</button></div>
                    @for (var setIndex = 0; setIndex < exercise.Sets.Count; setIndex++)
                    {
                        var set = exercise.Sets[setIndex];
                        <div class="set-editor-row">
                            <span class="set-number">@(setIndex + 1)</span>
                            <label><span>Повторы</span><input type="number" min="1" max="1000" inputmode="numeric" value="@set.Repetitions" @onchange="e => UpdateDraftSet(set, 'r', e)" /></label>
                            <label><span>Нагрузка</span><input type="number" min="0" max="100000" step="0.1" inputmode="decimal" value="@set.Load" @onchange="e => UpdateDraftSet(set, 'l', e)" /></label>
                            <label><span>Ед.</span><input value="@set.Unit" maxlength="20" placeholder="кг" @onchange="e => UpdateDraftSet(set, 'u', e)" /></label>
                            <button class="icon-button small remove-set" @onclick="() => RemoveSet(exercise, set)" disabled="@(exercise.Sets.Count == 1)" aria-label="Удалить подход">×</button>
                        </div>
                    }
                    <label class="field-label" for="exercise-note-@exercise.Id">Подсказка или особая цель</label><textarea id="exercise-note-@exercise.Id" class="text-area exercise-note-input" @bind="exercise.Note" placeholder="Например, вес на одну гантель; или 30 секунд удержания"></textarea>
