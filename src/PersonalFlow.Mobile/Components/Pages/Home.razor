    async Task SaveAnswer(ChangeEventArgs e) => await DebounceLearningSave(e, value => answerDraft = value);
    async Task SaveNotes(ChangeEventArgs e) => await DebounceLearningSave(e, value => notesDraft = value);
    async Task SaveEvidence(ChangeEventArgs e) => await DebounceLearningSave(e, value => evidenceDraft = value);

    async Task DebounceLearningSave(ChangeEventArgs e, Action<string> updateDraft)
    {
        updateDraft(e.Value?.ToString() ?? string.Empty);
        answerSaveCancellation?.Cancel();
        answerSaveCancellation?.Dispose();
        var cancellation = new CancellationTokenSource();
        answerSaveCancellation = cancellation;
        try
        {
            await Task.Delay(450, cancellation.Token);
            if (ReferenceEquals(answerSaveCancellation, cancellation))
                await InvokeAsync(PersistLearningDrafts);
        }
        catch (OperationCanceledException) { }
        finally
        {
            if (ReferenceEquals(answerSaveCancellation, cancellation))
            {
                answerSaveCancellation = null;
                cancellation.Dispose();
            }
        }
    }

    void CommitAnswer(ChangeEventArgs e) => CommitLearningDraft(e, value => answerDraft = value);
    void CommitNotes(ChangeEventArgs e) => CommitLearningDraft(e, value => notesDraft = value);
    void CommitEvidence(ChangeEventArgs e) => CommitLearningDraft(e, value => evidenceDraft = value);

    void CommitLearningDraft(ChangeEventArgs e, Action<string> updateDraft)
    {
        updateDraft(e.Value?.ToString() ?? string.Empty);
        PersistLearningDrafts();
    }

    void PersistLearningDrafts()
    {
        answerSaveCancellation?.Cancel();
        answerSaveCancellation?.Dispose();
        answerSaveCancellation = null;
        if (learningProgress.Answer == answerDraft && learningProgress.Notes == notesDraft && learningProgress.Evidence == evidenceDraft) return;
        learningProgress = learningProgress with { Answer = answerDraft, Notes = notesDraft, Evidence = evidenceDraft };
        Store.SaveLearningProgress(learningProgress);
    }

