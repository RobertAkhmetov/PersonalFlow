    static bool TryReadDate(ChangeEventArgs args, out DateTime value)
    {
        value = default;
        if (!DateOnly.TryParseExact(args.Value?.ToString(), "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.None, out var date)) return false;
        value = date.ToDateTime(TimeOnly.MinValue);
        return true;
