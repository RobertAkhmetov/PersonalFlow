    void SetRecurrencePattern(ChangeEventArgs e)
    {
        recurrencePattern = e.Value?.ToString() ?? "weekly";
        if (recurrencePattern == "weekdays") recurrenceWeekdays = [DayOfWeek.Monday, DayOfWeek.Tuesday, DayOfWeek.Wednesday, DayOfWeek.Thursday, DayOfWeek.Friday];
        else if (recurrencePattern == "weekends") recurrenceWeekdays = [DayOfWeek.Saturday, DayOfWeek.Sunday];
        else if (recurrencePattern == "weekly" && recurrenceWeekdays.Count == 0) recurrenceWeekdays = [DateOnly.FromDateTime(recurrenceStart).DayOfWeek];
        else if (recurrencePattern == "monthly") recurrenceMonthDay = DateOnly.FromDateTime(recurrenceStart).Day;
    }

    void SetRecurrenceInterval(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), NumberStyles.None, CultureInfo.InvariantCulture, out var value))
            recurrenceInterval = Math.Clamp(value, 1, 365);
    }

    void SetMonthDay(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), NumberStyles.None, CultureInfo.InvariantCulture, out var value))
            recurrenceMonthDay = Math.Clamp(value, 1, 31);
    }

    void ToggleWeekday(DayOfWeek day)
