        recurrencePattern = series.Frequency switch
        {
            RecurrenceFrequency.Daily => "daily",
            RecurrenceFrequency.Monthly => "monthly",
            RecurrenceFrequency.Weekly when recurrenceWeekdays.SetEquals([DayOfWeek.Monday, DayOfWeek.Tuesday, DayOfWeek.Wednesday, DayOfWeek.Thursday, DayOfWeek.Friday]) => "weekdays",
            RecurrenceFrequency.Weekly when recurrenceWeekdays.SetEquals([DayOfWeek.Saturday, DayOfWeek.Sunday]) => "weekends",
            _ => "weekly"
        };
